ge-external')\n","\"use client\";\n\nimport { useState } from \"react\";\nimport Image from \"next/image\";\nimport { PageHero } from \"@/components/page-hero\";\nimport { CheckIcon, BoltIcon, GridIcon, BrainIcon, CompassIcon } from \"@/components/icons\";\n\nconst pillars = [\n  { name: \"Vision\", focus: \"Mission alignment, goals, success definition\", icon: <CompassIcon /> },\n  { name: \"People\", focus: \"Roles, job descriptions, accountability, onboarding\", icon: <BrainIcon /> },\n  { name: \"Data\", focus: \"KPIs, scorecards, dashboards, metrics\", icon: <GridIcon /> },\n  { name: \"Processes\", focus: \"SOPs, workflows, handoffs, approvals, triggers\", icon: <BoltIcon /> },\n  { name: \"Meetings\", focus: \"Rhythms, cadences, communication tools, channels\", icon: <GridIcon /> },\n  { name: \"Issues\", focus: \"Pain points, recurring problems, bottlenecks, risks\", icon: <BoltIcon /> },\n];\n\nconst scoringRubric = [\n  { score: 1, level: \"Non-Existent\", desc: \"Nothing exists. No documentation, no tracking, no structure.\" },\n  { score: 2, level: \"Ad-Hoc\", desc: \"Informal. Lives in someone's head. Done differently each time.\" },\n  { score: 3, level: \"Partial\", desc: \"Partially documented. Inconsistently followed.\" },\n  { score: 4, level: \"Documented\", desc: \"Written down. Mostly followed. Some gaps in execution.\" },\n  { score: 5, level: \"Optimized\", desc: \"Fully documented, consistently executed, regularly reviewed.\" },\n];\n\nconst businessPhases = [\n  { title: \"Phase 0: Executive Alignment\", desc: \"Secure leadership buy-in and define engagement objectives.\" },\n  { title: \"Phase 1: Vision Alignment\", desc: \"Ensure mission, vision, and values are clear and current.\" },\n  { title: \"Phase 2: Leadership Assessment\", desc: \"Map the leadership team and identify operational gaps.\" },\n  { title: \"Phase 3: Quote-to-Cash\", desc: \"Map the complete revenue cycle from lead to payment.\" },\n  { title: \"Phase 4-7: Dept Discovery\", desc: \"Deep-dive 7-layer analysis of every department (Sales, Ops, Finance, etc).\" },\n  { title: \"Phase 8: Gap Analysis\", desc: \"Score gaps and prioritize them by impact and urgency.\" },\n  { title: \"Phase 9: Roadmap Creation\", desc: \"Build the implementation plan with quick wins and milestones.\" },\n  { title: \"Phase 10: Launch & Enable\", desc: \"Transfer knowledge, delegate authority, and ensure sustainability.\" },\n];\n\nconst nonprofitLayers = [\n  { layer: \"Layer 1: Vision\", desc: \"How well does the work connect to the church's mission?\" },\n  { layer: \"Layer 2: Data\", desc: \"What numbers do you track, and how often are they reviewed?\" },\n  { layer: \"Layer 3: People\", desc: \"Who serves, and is it clear what they do?\" },\n  { layer: \"Layer 4: Meetings\", desc: \"How does information flow within and across ministries?\" },\n  { layer: \"Layer 5: Processes\", desc: \"How is ministry work actually done week-to-week?\" },\n  { layer: \"Layer 6: Issues\", desc: \"What's broken, frustrating, or draining energy?\" },\n  { layer: \"Layer 7: Automation\", desc: \"What could technology, automation, or AI improve?\" },\n];\n\nexport default function OurProcessPage() {\n  const [activeTab, setActiveTab] = useState<\"nonprofit\" | \"business\">(\"nonprofit\");\n\n  return (\n    <main className=\"px-4 pb-20 pt-6 sm:px-6 lg:px-8\">\n      <div className=\"mx-auto flex max-w-[1440px] flex-col gap-12\">\n        <PageHero\n          eyebrow=\"Our Methodology\"\n          title=\"From tribal knowledge to documented, repeatable systems.\"\n          description=\"We use a structured framework to transform operations, whether you are a growing church or a scaling business. Choose your path below.\"\n          imageSrc=\"/images/service-collaboration.png\"\n        />\n\n        {/* Path Selector */}\n        <div className=\"flex flex-col items-center gap-6\">\n          <div className=\"inline-flex rounded-full border border-[var(--line)] bg-white/50 p-1.5 shadow-sm\">\n            <button\n              onClick={() => setActiveTab(\"nonprofit\")}\n              className={`rounded-full px-8 py-3 text-sm font-semibold transition-all ${\n                activeTab === \"nonprofit\"\n                  ? \"bg-[var(--blue)] text-white shadow-md\"\n                  : \"text-[var(--muted)] hover:text-[var(--navy)]\"\n              }`}\n            >\n              Nonprofit & Church\n            </button>\n            <button\n              onClick={() => setActiveTab(\"business\")}\n              className={`rounded-full px-8 py-3 text-sm font-semibold transition-all ${\n                activeTab === \"business\"\n                  ? \"bg-[var(--blue)] text-white shadow-md\"\n                  : \"text-[var(--muted)] hover:text-[var(--navy)]\"\n              }`}\n            >\n              BusinessOS\n            </button>\n          </div>\n        </div>\n\n        {/* Content Section */}\n        <div className=\"animate-fade-in relative min-h-[600px]\">\n          {activeTab === \"nonprofit\" ? (\n            <div className=\"grid gap-12 lg:grid-cols-[1fr_400px]\">\n              <div className=\"flex flex-col gap-10\">\n                <section>\n                  <h2 className=\"text-4xl font-semibold tracking-[-0.05em] text-[var(--navy)]\">\n                    Ministry Playbook Discovery\n                  </h2>\n                  <p className=\"mt-4 text-lg leading-8 text-[var(--muted)]\">\n                    A discovery intake process designed specifically for ministry environments. We assess every department against the Foundation Stone methodology to identify gaps, mapping, and automation opportunities.\n                  </p>\n                </section>\n\n                <div className=\"grid gap-4 sm:grid-cols-2\">\n                  {nonprofitLayers.map((l, i) => (\n                    <div key={i} className=\"rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-6 transition hover:-translate-y-1\">\n                      <p className=\"text-xs font-bold uppercase tracking-widest text-[var(--blue)]\">{l.layer}</p>\n                      <p className=\"mt-3 font-semibold text-[var(--navy)]\">{l.desc}</p>\n                    </div>\n                  ))}\n                </div>\n\n                <section className=\"rounded-[32px] border border-[var(--line)] bg-white p-8 shadow-sm\">\n                  <h3 className=\"text-2xl font-semibold text-[var(--navy)]\">The Scoring Guide</h3>\n                  <div className=\"mt-6 overflow-hidden rounded-xl border border-[var(--line)]\">\n                    <table className=\"w-full text-left text-sm\">\n                      <thead className=\"bg-[var(--panel)] text-[var(--navy)]\">\n                        <tr>\n                          <th className=\"px-4 py-3 font-semibold\">Score</th>\n                          <th className=\"px-4 py-3 font-semibold\">Level</th>\n                          <th className=\"px-4 py-3 font-semibold\">Description</th>\n                        </tr>\n                      </thead>\n                      <tbody className=\"divide-y divide-[var(--line)]\">\n                        {scoringRubric.map((r) => (\n                          <tr key={r.score} className=\"hover:bg-slate-50 transition\">\n                            <td className=\"px-4 py-4 font-bold text-[var(--blue)]\">{r.score}</td>\n                            <td className=\"px-4 py-4 font-semibold\">{r.level}</td>\n                            <td className=\"px-4 py-4 text-[var(--muted)]\">{r.desc}</td>\n                          </tr>\n                        ))}\n                      </tbody>\n                    </table>\n                  </div>\n                </section>\n              </div>\n\n              <aside className=\"sticky top-8 h-fit space-y-6\">\n                <div className=\"rounded-[30px] bg-[var(--navy)] p-8 text-white shadow-xl\">\n                  <h4 className=\"text-xl font-bold\">Ministry Add-Ons</h4>\n                  <p className=\"mt-2 text-white/70 text-sm\">Specialized assessments for specific ministry areas:</p>\n                  <ul className=\"mt-6 space-y-4\">\n                    {[\"Worship & Production\", \"Kids & Youth Ministry\", \"Small Groups\", \"Giving & Stewardship\", \"Guest Follow-Up\"].map(add => (\n                      <li key={add} className=\"flex items-center gap-3 text-sm font-medium\">\n                        <div className=\"text-[var(--teal)]\"><CheckIcon /></div>\n                        {add}\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n              </aside>\n            </div>\n          ) : (\n            <div className=\"flex flex-col gap-16\">\n              {/* BusinessOS Header */}\n              <section className=\"text-center lg:text-left\">\n                <h2 className=\"text-4xl font-semibold tracking-[-0.05em] text-[var(--navy)]\">\n                  BusinessOS Discovery Framework\n                </h2>\n                <p className=\"mt-4 max-w-3xl text-lg leading-8 text-[var(--muted)]\">\n                  An 8-16 week framework for transforming business operations from tribal knowledge to documented, measurable, repeatable systems.\n                </p>\n              </section>\n\n              {/* 6 Pillars Grid */}\n              <section className=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-3\">\n                {pillars.map((p) => (\n                  <div key={p.name} className=\"group rounded-[28px] border border-[var(--line)] bg-white p-8 shadow-sm transition hover:shadow-md hover:-translate-y-1\">\n                    <div className=\"flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--blue)] text-white group-hover:scale-110 transition\">\n                      {p.icon}\n                    </div>\n                    <h4 className=\"mt-6 text-2xl font-bold text-[var(--navy)]\">{p.name}</h4>\n            